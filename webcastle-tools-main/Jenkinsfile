pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        // Docker Hub Configuration
        DOCKERHUB_USERNAME = 'sumithksam'
        DOCKERHUB_CREDENTIALS_ID = 'docker-pat'

        // Docker Image
        IMAGE_NAME = 'credvault'
        IMAGE_TAG = "${BUILD_NUMBER}"
        LOCAL_IMAGE = "credvault:${BUILD_NUMBER}"
        DOCKERHUB_IMAGE = "sumithksam/credvault:${BUILD_NUMBER}"

        // Kubernetes Manifest
        K8S_MANIFEST = 'k8s/deployment.yaml'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo 'CredVault source code checked out successfully.'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('webcastle-tools-main') {
                    sh '''
                        docker run --rm \
                        -v "$PWD:/app" \
                        -w /app \
                        oven/bun:1 \
                        bun install --frozen-lockfile
                    '''
                }
            }
        }

        stage('SAST Scan - Semgrep') {
            steps {
                sh '''
                    mkdir -p "$WORKSPACE/reports"

                    docker run --rm \
                    -v "$WORKSPACE/webcastle-tools-main:/src" \
                    -v "$WORKSPACE/reports:/reports" \
                    semgrep/semgrep \
                    semgrep scan \
                    --config auto \
                    --json \
                    --output /reports/semgrep.json \
                    /src
                '''
            }
        }

        stage('Trivy Filesystem Scan') {
            steps {
                sh '''
                    docker run --rm \
                    -v "$WORKSPACE/webcastle-tools-main:/src" \
                    -v "$WORKSPACE/reports:/reports" \
                    aquasec/trivy:latest \
                    fs \
                    --scanners vuln,misconfig,secret \
                    --format json \
                    --output /reports/trivy-fs.json \
                    --exit-code 0 \
                    /src
                '''
            }
        }

        stage('Docker Build') {
            steps {
                dir('webcastle-tools-main') {
                    sh '''
                        docker build \
                        -t "$LOCAL_IMAGE" .
                    '''
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    docker run --rm \
                    -v /var/run/docker.sock:/var/run/docker.sock \
                    -v "$WORKSPACE/reports:/reports" \
                    aquasec/trivy:latest \
                    image \
                    --format json \
                    --output /reports/trivy-image.json \
                    --exit-code 0 \
                    "$LOCAL_IMAGE"
                '''
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKERHUB_CREDENTIALS_ID}",
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "$DOCKERHUB_PASSWORD" | docker login \
                        --username "$DOCKERHUB_USER" \
                        --password-stdin

                        docker tag "$LOCAL_IMAGE" "$DOCKERHUB_IMAGE"

                        docker push "$DOCKERHUB_IMAGE"

                        echo "$DOCKERHUB_IMAGE" > "$WORKSPACE/reports/image-uri.txt"

                        docker logout
                    '''
                }
            }
        }

        stage('Update Kubernetes Manifest') {
            steps {
                sh '''
                    if [ ! -f "$K8S_MANIFEST" ]; then
                        echo "Kubernetes manifest not found!"
                        exit 1
                    fi

                    sed -i -E \
                    "s#(^[[:space:]]*image:[[:space:]]*).*#\\\\1${DOCKERHUB_IMAGE}#" \
                    "$K8S_MANIFEST"

                    echo "Updated Kubernetes image:"
                    grep "image:" "$K8S_MANIFEST"
                '''
            }
        }

        stage('Push Manifest to GitHub') {
            steps {
                withCredentials([
                    gitUsernamePassword(
                        credentialsId: 'github-pat',
                        gitToolName: 'Default'
                    )
                ]) {
                    sh '''
                        git config user.name "Sumith K Sam"
                        git config user.email "sumith@zoople.in"

                        git remote set-url origin https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/sumith-k-sam/Castle_Tools.git

                        git add k8s/deployment.yaml

                        if ! git diff --cached --quiet; then
                            git commit -m "Update CredVault image to ${IMAGE_TAG} [skip ci]"
                        else
                            echo "No manifest changes to commit."
                        fi

                        git pull --rebase origin main

                        git push origin HEAD:main
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'reports/**/*, k8s/deployment.yaml',
                allowEmptyArchive: true,
                fingerprint: true
            )
        }

        success {
            echo 'CredVault CI/CD pipeline completed successfully!'
        }

        failure {
            echo 'CredVault pipeline failed. Check Jenkins console output.'
        }
    }
}
